# Stripe — required for checkout. Get keys at https://dashboard.stripe.com/apikeys
# Use your TEST key (sk_test_...) while developing.
STRIPE_SECRET_KEY=sk_test_xxx

# Your public site URL. Required in production so Stripe can show product
# images and build correct success/cancel URLs. Leave unset in local dev.
# NEXT_PUBLIC_SITE_URL=https://lyfepeptidescanada.com

# Admin dashboard (/admin). Pick a long password; ADMIN_SECRET signs the login cookie.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=a-long-random-string

# Optional: records orders even if a customer closes the tab before the success page.
# Stripe dashboard > Developers > Webhooks > endpoint https://<domain>/api/stripe/webhook (checkout.session.completed)
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: turns the support chatbot from FAQ answers into Claude.
# ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: "Continue with Google" in the 10% pop-up. Google Cloud Console > Credentials >
# OAuth client ID (Web application); add your site (and http://localhost:3000) to Authorized JavaScript origins.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Storage on Vercel: connect Upstash Redis (Vercel > Storage > Marketplace); these are then added for you.
# Locally, leave them unset and data is written to ./data instead.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
