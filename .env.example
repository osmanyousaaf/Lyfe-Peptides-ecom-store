# Stripe — required for checkout. Get keys at https://dashboard.stripe.com/apikeys
# Use your TEST key (sk_test_...) while developing.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the webhook at /api/stripe/webhook (whsec_...). It records paid orders in the admin.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=

# Your public site URL. Required in production so Stripe can show product
# images and build correct success/cancel URLs. Leave unset in local dev.
# NEXT_PUBLIC_SITE_URL=https://lyfepeptidescanada.com

# Claude — powers the chat assistant. Without it the chat answers from a built-in
# FAQ and catalog search. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Admin panel (/admin). One password for the store owner.
ADMIN_PASSWORD=
# Optional: secret used to sign admin sessions (random 64 hex chars).
ADMIN_SECRET=
# Optional: where the SQLite database and uploaded images live (default ./data).
# DATA_DIR=/var/lib/lyfe

# Signs customer login sessions (random 64 hex chars).
AUTH_SECRET=

# "Continue with Google" sign-in. Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# <your site>/api/auth/google/callback (http://localhost:3000/api/auth/google/callback locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (discount codes, order updates). For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<a Google "app password">.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lyfe Peptides <you@gmail.com>"
