# Development container: runs `next dev` with hot reload.
# node_modules is built fresh inside the image (Linux) rather than reusing the
# host's macOS node_modules, since better-sqlite3 is a native module.
FROM node:22-bookworm-slim

# build tools for native modules (better-sqlite3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# source is bind-mounted over this in docker-compose for live editing;
# this COPY just lets the image run standalone too.
COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]
